# FieldWise AI (Napta) - Environment Configuration
APP_NAME="FieldWise AI - Egypt Edition"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# External Data APIs
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/climatology/point"
SOILGRIDS_BASE_URL="https://rest.isric.org/soilgrids/v2.0/properties/query"

# Cache Configuration
CACHE_TTL_DAYS=30
CACHE_DB_PATH="data/processed/cache.sqlite"

# Voice & Dialect Configuration
ASR_PROVIDER="browser" # options: browser, whisper_api, local
TTS_PROVIDER="browser" # options: browser, edge_tts
LLM_PARSER_PROVIDER="deterministic" # options: deterministic, openai, anthropic
# OPENAI_API_KEY=your_key_here
